{
  "name": "plugin-sentence-completion",
  "version": "0.0.1",
  "description": "Shows the participant a sentence containing some gaps, and a bank of buttons. Each button click fills in one gap.",
  "unpkg": "dist/index.browser.min.js",
  "files": [
    "index.js",
    "dist"
  ],
  "scripts": {
    "build": "babel index.js --presets @babel/preset-env,minify --source-maps --out-file dist/index.browser.min.js",
    "build:watch": "npm run build -- --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aislinnkeogh/jspsych-contrib.git",
    "directory": ""
  },
  "keywords": [
    "jsPsych"
  ],
  "author": {
    "name": "Aislinn Keogh, Christian Mott, and Bran Papineau",
    "url": "https://github.com/aislinnkeogh"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aislinnkeogh/jspsych-contrib/issues"
  },
  "homepage": "/plugin-sentence-completion/README.md",
  "dependencies": {
    "jspsych": "^8.0.0",
    "@citation-js/core": "^0.7.14",
    "@citation-js/plugin-software-formats": "^0.6.1",
    "@citation-js/plugin-bibtex": "^0.7.14",
    "@citation-js/plugin-cff": "^0.6.1"
  },
  "devDependencies": {
    "@jspsych/config": "^3.2.2"
  }
}
